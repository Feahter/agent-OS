{
  "agent_timeout_seconds": 600,
  "check_commands": [
    [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests"
    ]
  ],
  "data_classification": "public",
  "instruction_files": [
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "max_agent_calls": 8,
  "max_elapsed_seconds": 1800,
  "max_review_cycles": 2,
  "protected_paths": [
    ".git/HEAD",
    ".git/index",
    ".git/config",
    ".git/packed-refs",
    ".git/refs",
    ".agent-os/engineering.json",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "require_clean_worktree": true,
  "role_executors": {},
  "schema_version": 1
}
